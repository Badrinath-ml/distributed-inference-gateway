# Worker 1 launch configuration.
#
# This file is the single source of truth for the Worker 1 vLLM command.
# Environment variables set before invoking scripts/start_worker1.sh override
# these defaults, which allows controlled experiments without duplicating
# values in multiple files.
#
# Selected configuration (Stage 2/3, 2026-11-18):
#   target Qwen/Qwen3-1.7B, draft Qwen/Qwen3-0.6B, FP16,
#   max model length 1024, max sequences 2, KV cache 512 MiB,
#   two speculative tokens, eager mode.
#
# Selection evidence: benchmarks/final_stage2_stage3_report_20261118T0000Z.md.
# 512 MiB was the only swept allocation able to hold two full 1024-token
# requests (2336 KV tokens, 2.28x), and max-num-seqs=2 removed all waiting
# while roughly doubling concurrency-2 throughput with speculative decoding
# unchanged.
#
# Rollback to the previous baseline (256 MiB KV, max-num-seqs=1) without
# editing this file:
#   VLLM_KV_CACHE_MEMORY_BYTES=268435456 VLLM_MAX_NUM_SEQS=1 \
#     scripts/start_worker1.sh
# The pre-promotion file is preserved at
#   backups/worker1.env.pre-promotion-20261117T192040Z
#
# Rollback command with the same safety checks used during the experiments:
#   .venv/bin/python scripts/stage2_restart_vllm.py --kv-mib 256 --max-num-seqs 1

export VLLM_TARGET_MODEL="${VLLM_TARGET_MODEL:-Qwen/Qwen3-1.7B}"
export VLLM_DRAFT_MODEL="${VLLM_DRAFT_MODEL:-Qwen/Qwen3-0.6B}"
export VLLM_HOST="${VLLM_HOST:-0.0.0.0}"
export VLLM_PORT="${VLLM_PORT:-8000}"
export VLLM_DTYPE="${VLLM_DTYPE:-half}"
export VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-1024}"
export VLLM_MAX_NUM_SEQS="${VLLM_MAX_NUM_SEQS:-2}"
export VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.80}"
export VLLM_KV_CACHE_MEMORY_BYTES="${VLLM_KV_CACHE_MEMORY_BYTES:-536870912}"
export VLLM_NUM_SPECULATIVE_TOKENS="${VLLM_NUM_SPECULATIVE_TOKENS:-2}"
export VLLM_ENFORCE_EAGER="${VLLM_ENFORCE_EAGER:-1}"
export VLLM_USE_FLASHINFER_SAMPLER="${VLLM_USE_FLASHINFER_SAMPLER:-0}"
