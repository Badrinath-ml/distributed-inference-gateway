# Worker 1 launch configuration.
#
# This file is the single source of truth for the Worker 1 vLLM command.
# Environment variables set before invoking scripts/start_worker1.sh override
# these defaults, which allows controlled KV-cache / concurrency experiments
# without duplicating values in multiple files.
#
# Final selected configuration after Stage 5:
#   target Qwen/Qwen3-1.7B, draft Qwen/Qwen3-0.6B, FP16,
#   max model length 1024, max sequences 1, KV 256 MiB,
#   two speculative tokens, eager mode.

export VLLM_TARGET_MODEL="${VLLM_TARGET_MODEL:-Qwen/Qwen3-1.7B}"
export VLLM_DRAFT_MODEL="${VLLM_DRAFT_MODEL:-Qwen/Qwen3-0.6B}"
export VLLM_HOST="${VLLM_HOST:-0.0.0.0}"
export VLLM_PORT="${VLLM_PORT:-8000}"
export VLLM_DTYPE="${VLLM_DTYPE:-half}"
export VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-1024}"
export VLLM_MAX_NUM_SEQS="${VLLM_MAX_NUM_SEQS:-1}"
export VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.80}"
export VLLM_KV_CACHE_MEMORY_BYTES="${VLLM_KV_CACHE_MEMORY_BYTES:-268435456}"
export VLLM_NUM_SPECULATIVE_TOKENS="${VLLM_NUM_SPECULATIVE_TOKENS:-2}"
export VLLM_ENFORCE_EAGER="${VLLM_ENFORCE_EAGER:-1}"
export VLLM_USE_FLASHINFER_SAMPLER="${VLLM_USE_FLASHINFER_SAMPLER:-0}"
