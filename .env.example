# Copy to .env and edit. Never commit real secrets.

# ---- Worker 1: local vLLM -------------------------------------------------
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=Qwen/Qwen3-1.7B
# Qwen3: suppress <think> blocks in user-facing completions by default.
VLLM_ENABLE_THINKING=false
# Optional: Modal Proxy Token in the form wk-...ws-... (keep secret)
# VLLM_API_KEY=
GATEWAY_PORT=8080
# WORKER1_ENABLED=true
# WORKER1_ID=worker1-local-vllm
# WORKER1_TIMEOUT_SECONDS=120
# WORKER1_MAX_CONCURRENCY=2
# Qwen3: disable internal <think> output in user-facing responses (default false).
# VLLM_ENABLE_THINKING=false

# ---- Stage 4: CPU embedding executor -------------------------------------
# Selected by the measured matrix: 1 worker x 8 torch intra-op threads.
# See docs/benchmarks.md. Unset EMBEDDING_TORCH_THREADS to keep PyTorch's
# platform default instead.
EMBEDDING_EXECUTOR_WORKERS=1
EMBEDDING_TORCH_THREADS=8

# ---- Dashboard / development-only fault injection ----------------------
# Keep false on any shared or production instance. Only mock workers are targetable.
DASHBOARD_FAULT_INJECTION_ENABLED=false

# ---- Health monitoring ---------------------------------------------------
# HEALTH_CHECK_ENABLED=true
# HEALTH_CHECK_INTERVAL_SECONDS=15
# HEALTH_CHECK_TIMEOUT_SECONDS=3

# ---- Worker 2: OpenRouter (optional) -------------------------------------
# Set BOTH the key and the model to register the worker. The example below is a
# currently free model. Free model availability changes often: check
# GET https://openrouter.ai/api/v1/models and update OPENROUTER_MODEL if the
# provider retires it.
# OPENROUTER_ENABLED=true
# OPENROUTER_API_KEY=
# Choose a currently listed Gemma or Llama model; free pool availability can change.
# Example Gemma: google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=60
# OPENROUTER_MAX_CONCURRENCY=4
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=distributed-speculative-decoder-inference-semantic-routing-gateway

# ---- Worker 3: deterministic mock worker (development only) --------------
# MOCK_WORKER_ENABLED=false
# MOCK_WORKER_ID=worker3-mock
# MOCK_WORKER_MODEL=mock-qwen
# MOCK_WORKER_LATENCY_MS=0
# MOCK_WORKER_MAX_CONCURRENCY=4

# ---- Routing -------------------------------------------------------------
# ROUTING_RETRY_ON_CONNECT_ERROR=true
